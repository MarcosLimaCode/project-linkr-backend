datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  image     String
  posts     Post[]
}

model Post {
  id          Int      @id @default(autoincrement())
  link        String
  description String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])  
}